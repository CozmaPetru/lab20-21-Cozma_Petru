@model List<TarifNou>
@{
    ViewData["Title"] = "Tarife";
}

<h1>Tarifele camerelor</h1>

<form asp-action="Tarife" method="post" id="formTarife">
    <table class="table table-sm table-striped w-auto">
        <thead><tr><th>Camera</th><th>Tariful, lei/lună</th></tr></thead>
        <tbody>
            @* Sarcina 4: aici scrii rândurile tabelului. *@
        </tbody>
    </table>
    <button type="submit" class="btn btn-primary">Salvează tarifele</button>
</form>

@if (Context.Request.Method == "POST")
{
    <partial name="_Sonda" />
}
