@model Persoana
@{
    ViewData["Title"] = "Tutorele";
}

<h1>Datele tutorelui</h1>

<div class="card border-primary mb-3" id="primit">
    <div class="card-header py-1 small fw-bold">Ce a primit acțiunea</div>
    <div class="card-body py-2 small font-monospace">
        <div>Nume = <span id="numeTutore">@Model.Nume</span></div>
        <div>Telefon = <span id="telefonTutore">@Model.Telefon</span></div>
    </div>
</div>

<partial name="_Sonda" />
<a asp-action="Noua" class="btn btn-link">Înapoi</a>
