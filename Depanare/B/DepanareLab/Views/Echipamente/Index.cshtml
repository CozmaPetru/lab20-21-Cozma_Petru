@model List<Echipament>
@{
    ViewData["Title"] = "Echipamente";
}

<h1>Inventarul laboratorului</h1>
<p>Echipamente: <strong id="numar">@Model.Count</strong> · Valoarea totală: <strong id="total">@ViewBag.Total</strong> lei</p>

<table class="table table-sm table-striped" id="lista">
    <thead><tr><th>Denumirea</th><th>Seria</th><th>Anul</th><th>Prețul</th><th></th></tr></thead>
    <tbody>
        @foreach (Echipament item in Model)
        {
            <tr data-id="@item.Id">
                <td class="denumire">@item.Denumirea</td>
                <td>@item.Serie</td>
                <td>@item.An</td>
                <td class="pret">@item.Pret.ToString("N2")</td>
                <td class="d-flex gap-1">
                    <a asp-action="Detalii" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">Detalii</a>
                    <a asp-action="Editeaza" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Editează</a>
                    <form asp-action="Sterge" asp-route-id="@item.Id" method="post"><button type="submit" class="btn btn-outline-danger btn-sm">Șterge</button></form>
                </td>
            </tr>
        }
    </tbody>
</table>
