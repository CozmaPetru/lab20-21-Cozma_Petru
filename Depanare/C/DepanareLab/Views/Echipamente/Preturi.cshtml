@model List<PretNou>
@{
    ViewData["Title"] = "Prețuri";
}

<h1>Prețurile echipamentelor</h1>
<form asp-action="Preturi" method="post">
    <table class="table table-sm w-auto">
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td>
                        @Model[i].Denumire
                        <input type="hidden" asp-for="@Model[i].Denumire" />
                    </td>
                    <td><input asp-for="@Model[i].Pret" class="form-control form-control-sm pretNou" /></td>
                </tr>
            }
        </tbody>
    </table>
    <button type="submit" class="btn btn-primary">Salvează</button>
</form>
