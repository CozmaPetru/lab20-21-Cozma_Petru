<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DepanareLab</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Echipamente" asp-action="Index">DepanareLab</a>
                <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Echipamente" asp-action="Index">Echipamente</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Echipamente" asp-action="Adauga">Adaugă</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Echipamente" asp-action="Cauta">Caută</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Echipamente" asp-action="Preturi">Prețuri</a>
                        </li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top text-muted small py-2 mt-4">
        <div class="container">&copy; 2026 · DepanareLab · Inventarul laboratorului</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
